{
  "uid": "fluxguard-overview",
  "title": "FluxGuard Overview",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "10s",
  "time": {"from": "now-1h", "to": "now"},
  "panels": [
    {"id": 1, "title": "Gateway requests / second", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "sum(rate(spring_cloud_gateway_requests_seconds_count[5m]))", "refId": "A"}]},
    {"id": 2, "title": "Gateway P95 latency", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(spring_cloud_gateway_requests_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 3, "title": "HTTP responses", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "sum by (httpStatusCode) (rate(spring_cloud_gateway_requests_seconds_count[5m]))", "refId": "A"}]},
    {"id": 4, "title": "Rate limited requests", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "sum by (route) (rate(fluxguard_rate_limited_total[5m]))", "refId": "A"}]},
    {"id": 5, "title": "Service availability", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "up", "refId": "A"}]},
    {"id": 6, "title": "JVM memory", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 16}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\"})", "refId": "A"}]},
    {"id": 7, "title": "Gateway P99 latency", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "histogram_quantile(0.99, sum by (le) (rate(spring_cloud_gateway_requests_seconds_bucket[5m])))", "refId": "A"}]},
    {"id": 8, "title": "Authentication and authorization rejections", "type": "timeseries", "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24}, "datasource": {"type": "prometheus", "uid": "fluxguard-prometheus"}, "targets": [{"expr": "sum(rate(fluxguard_auth_failures_total[5m]))", "refId": "A"}, {"expr": "sum(rate(fluxguard_authorization_denied_total[5m]))", "refId": "B"}]}
  ]
}
